extends Resource
## One civilian traffic vehicle type (res://data/traffic/<id>.tres, generated by tools/make_traffic_data.gd).
## Holds presentation + behaviour numbers and builds the CarData used when the vehicle runs in physics LOD.

@export var id: String = ""
@export var display_name: String = ""
## Blender export; when missing the traffic manager falls back to a similar-sized player car model.
@export var model_path: String = ""

@export_group("Body")
@export var mass: float = 1200.0
@export var length: float = 4.1
@export var width: float = 1.75
@export var height: float = 1.5
@export var wheelbase: float = 2.55
@export var wheel_radius: float = 0.31
@export var com_height: float = 0.55
@export var front_drive: bool = true

@export_group("Driving")
@export var max_speed_kmh: float = 150.0
## Comfortable acceleration / braking (m/s^2).
@export var accel: float = 2.0
@export var decel: float = 3.0
@export var power_kw: float = 75.0
## Lateral acceleration a calm driver of this vehicle accepts in corners (g).
@export var corner_g: float = 0.27
## Minimum following time gap (s); each driver adds a random 0..0.5 s.
@export var time_gap: float = 1.8
## Multiplier on the posted limit range this vehicle normally drives at (lorries < 1).
@export var limit_factor: float = 1.0

@export_group("Spawning")
## WorldLayout.RoadClass values this vehicle may drive on.
@export var allowed_classes: PackedInt32Array = PackedInt32Array([0, 1, 2, 3])
## Region ids (0 vale, 1 highlands, 2 mesa, 3 coast); empty = everywhere.
@export var allowed_regions: PackedInt32Array = PackedInt32Array()
@export var spawn_weight: float = 1.0
## Keys of Game.PAINT_COLORS the vehicle is painted with.
@export var paints: PackedStringArray = PackedStringArray(["white", "silver", "grey", "blue", "red"])
## 0 gloss, 1 matte, 2 metallic (picked at random among these).
@export var finishes: PackedInt32Array = PackedInt32Array([0, 2])

@export_group("Sound")
@export var horn_hz: float = 440.0


func allows(road_class: int, region: int) -> bool:
	if not allowed_classes.has(road_class):
		return false
	return allowed_regions.is_empty() or allowed_regions.has(region)


## Handling data for physics LOD. `fallback` is the player-car CarData whose model stands in for a missing
## traffic model: its geometry is kept, its power is scaled to this type's power-to-weight ratio and it is
## regeared for this type's speed range (the borrowed gearing is far too tall for the reduced torque: heavy
## types could not hold a 10 % climb).
func make_car_data(model: String, fallback: CarData) -> CarData:
	if fallback != null:
		var f: CarData = fallback.duplicate(true)
		f.id = id + "_placeholder"
		f.display_name = display_name
		f.model_path = model
		f.top_speed_kmh = max_speed_kmh
		var want_kw := power_kw * f.mass / mass
		f.peak_torque *= want_kw / maxf(f.peak_power_kw(), 1.0)
		f.brake_force = f.mass * 9.81 * 1.1
		_set_gearing(f, f.wheel_radius_rear, 5 if mass < 3000.0 else 6)
		return f
	var d := CarData.new()
	d.id = id
	d.display_name = display_name
	d.category = "Traffic"
	d.model_path = model
	d.mass = mass
	d.com = Vector3(0.0, com_height, -0.05 * wheelbase)
	d.inertia_scale = Vector3(1.1, 1.1, 1.1)
	d.idle_rpm = 750.0
	d.redline_rpm = 4600.0 if mass > 3000.0 else 5800.0
	d.max_rpm = d.redline_rpm + 300.0
	d.drivetrain = CarData.Drivetrain.FWD if front_drive else CarData.Drivetrain.RWD
	d.diff_lock = 0.2
	d.tire_grip = 0.95
	d.offroad_tires = 0.7 if max_speed_kmh < 60.0 else 0.1
	d.wheelbase = wheelbase
	d.track_front = width * 0.86
	d.track_rear = width * 0.86
	d.wheel_radius_front = wheel_radius
	d.wheel_radius_rear = wheel_radius
	d.body_size = Vector3(width, height, length)
	# Springs for ~9 cm static sag, dampers at ~30% of critical.
	var corner_load := mass * 9.81 * 0.25
	var k := corner_load / 0.09
	d.spring_front = k
	d.spring_rear = k * 1.05
	var crit := 2.0 * sqrt(k * mass * 0.25)
	d.damper_bump = crit * 0.25
	d.damper_rebound = crit * 0.38
	d.suspension_travel = 0.22 if mass < 3000.0 else 0.26
	d.anti_roll_front = k * 0.35
	d.anti_roll_rear = k * 0.22
	d.downforce_front = 0.0
	d.downforce_rear = 0.0
	d.brake_force = mass * 9.81 * 1.0
	d.handbrake_force = mass * 9.81 * 0.6
	d.max_steer_deg = 36.0
	d.high_speed_steer_deg = 9.0
	d.steer_rate = 2.6
	d.top_speed_kmh = max_speed_kmh
	d.peak_torque = 100.0
	d.peak_torque = 100.0 * power_kw / maxf(d.peak_power_kw(), 1.0)
	_set_gearing(d, wheel_radius, 5 if mass < 3000.0 else 6)
	# Drag area that balances the power at the top speed.
	var v_top := max_speed_kmh / 3.6
	var p_w := power_kw * 1000.0 * 0.85
	var roll := d.rolling_resistance * mass * 9.81 * v_top
	d.drag_area = clampf((p_w - roll) / (0.5 * 1.225 * pow(v_top, 3.0)), 0.5, 6.0)
	return d


## Top gear reaches the top speed near the redline, first gear ~40 km/h (tractor ~12 km/h).
func _set_gearing(d: CarData, radius: float, gears: int) -> void:
	var w_red := d.redline_rpm * TAU / 60.0
	var v_top := max_speed_kmh / 3.6
	d.final_drive = 3.9
	var top_ratio := w_red * radius / (v_top * 1.02) / d.final_drive
	var first_ratio := w_red * radius / (minf(40.0, max_speed_kmh * 0.32) / 3.6) / d.final_drive
	var ratios := PackedFloat32Array()
	for i in gears:
		var t := float(i) / float(gears - 1)
		ratios.append(first_ratio * pow(top_ratio / first_ratio, pow(t, 0.9)))
	d.gear_ratios = ratios
	d.reverse_ratio = first_ratio * 0.95
