[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="traffic"
3d_physics/layer_4="triggers"
3d_physics/layer_5="props_dynamic"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=10
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/world_boundary_shape_size=8000.0
jolt_physics_3d/limits/max_linear_velocity=250.0
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=2048
