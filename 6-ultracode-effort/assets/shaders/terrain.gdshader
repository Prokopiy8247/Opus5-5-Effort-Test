shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;
// Terrain material: tiled photo-like ground textures (albedo + roughness-in-alpha + tangent normal,
// generated by tools/make_terrain_textures.gd) blended by region vertex colour (r vale, g highlands,
// b mesa, a coast) and slope, same as before. Anti-tiling: stochastic (jittered-lattice) sampling of
// the detail scale, a non-integer macro scale on top, and large-scale colour variation from noise.
// Region tints keep the per-region character (fields, red strata, beach...). Wetness, puddles,
// snow_line/snow_cover and road verges behave exactly as before.

#include "res://assets/shaders/road_verge.gdshaderinc"

uniform sampler2D noise_large : filter_linear_mipmap, repeat_enable;
uniform sampler2D noise_detail : filter_linear_mipmap, repeat_enable;
uniform sampler2D road_dist_tex : filter_linear, repeat_disable;
uniform float map_half = 2048.0;
uniform float wetness : hint_range(0.0, 1.0) = 0.0;
uniform float snow_line = 330.0;
uniform float snow_cover : hint_range(0.0, 1.0) = 0.0;
// Ground textures: albedo RGB + roughness in alpha, matching tangent-space normals.
uniform float tex_scale = 0.55;      // detail tile size in metres (1/scale repeats per metre)
uniform sampler2D tex_grass_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_grass_normal : filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_field_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_field_normal : filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_dirt_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_dirt_normal : filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_gravel_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_gravel_normal : filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_sand_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_sand_normal : filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_rock_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_rock_normal : filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_snow_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D tex_snow_normal : filter_linear_mipmap, repeat_enable;

varying vec3 wpos;
varying vec4 region;
varying vec3 wnrm;

float hash2(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

vec2 hash2v(vec2 p) {
	return vec2(hash2(p), hash2(p + vec2(41.3, 289.1)));
}

// Stochastic sampling (Mikkelsen-style jittered lattice, 4 taps): each lattice cell samples a
// randomly shifted copy of the tileable texture, so the periodic pattern never lines up.
vec4 stochastic(sampler2D t, vec2 p) {
	vec2 iid = floor(p);
	vec2 f = p - iid;
	vec2 o00 = hash2v(iid) - 0.5;
	vec2 o10 = hash2v(iid + vec2(1.0, 0.0)) - 0.5;
	vec2 o01 = hash2v(iid + vec2(0.0, 1.0)) - 0.5;
	vec2 o11 = hash2v(iid + vec2(1.0, 1.0)) - 0.5;
	vec2 fw = f * f * (3.0 - 2.0 * f);
	// Corner uvs are continuous across cell borders because the texture repeats.
	vec4 c00 = texture(t, f + o00);
	vec4 c10 = texture(t, f + vec2(1.0, 0.0) + o10);
	vec4 c01 = texture(t, f + vec2(0.0, 1.0) + o01);
	vec4 c11 = texture(t, f + vec2(1.0, 1.0) + o11);
	return mix(mix(c00, c10, fw.x), mix(c01, c11, fw.x), fw.y);
}

// Detail (stochastic) sample; long-range repetition is masked by the large-scale colour variation.
vec4 ground(sampler2D t, vec2 xz) {
	return stochastic(t, xz * tex_scale);
}

vec3 ground_n(sampler2D nt, vec2 xz) {
	vec3 d = texture(nt, xz * tex_scale).rgb * 2.0 - 1.0;
	d.y = -d.y;
	return normalize(vec3(d.x, d.y, d.z));
}

vec3 triplanar_rock(vec3 p, vec3 n, vec3 base_a, vec3 base_b) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z);
	float x = texture(noise_detail, p.zy * 0.11).r;
	float y = texture(noise_detail, p.xz * 0.11).r;
	float z = texture(noise_detail, p.xy * 0.11).r;
	float t = x * w.x + y * w.y + z * w.z;
	float x2 = texture(noise_detail, p.zy * 0.031).r;
	float z2 = texture(noise_detail, p.xy * 0.031).r;
	float y2 = texture(noise_detail, p.xz * 0.031).r;
	float t2 = x2 * w.x + y2 * w.y + z2 * w.z;
	return mix(base_a, base_b, clamp(t * 0.6 + t2 * 0.7 - 0.2, 0.0, 1.0));
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	region = COLOR;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	// Chunks are axis-aligned world-grid meshes: a horizontal tangent suffices for the normal maps.
	vec3 t = cross(NORMAL, vec3(0.0, 0.0, 1.0));
	TANGENT = normalize(length(t) < 0.01 ? vec3(1.0, 0.0, 0.0) : t);
}

void fragment() {
	vec3 n = normalize(wnrm);
	float slope = 1.0 - n.y;
	float h = wpos.y;
	vec2 xz = wpos.xz;
	float nl = texture(noise_large, xz * 0.0011).r;
	float nm = texture(noise_large, xz * 0.0073).r;
	float nd = texture(noise_detail, xz * 0.09).r;
	float nf = texture(noise_detail, xz * 0.47).r;

	// Ground samples used by several regions.
	vec4 grass_s = ground(tex_grass_albedo, xz);
	vec3 grass_n = ground_n(tex_grass_normal, xz);
	vec4 sand_s = ground(tex_sand_albedo, xz);
	vec3 sand_n = ground_n(tex_sand_normal, xz);
	vec4 rock_s = ground(tex_rock_albedo, xz);
	vec3 rock_n = ground_n(tex_rock_normal, xz);
	float dist_cam = length(wpos - CAMERA_POSITION_WORLD);
	// Detail normals fade out with distance so the far terrain does not shimmer.
	float nfade = 1.0 - smoothstep(70.0, 160.0, dist_cam);

	// ---- Vale: meadows + patchwork fields
	vec3 meadow = grass_s.rgb * mix(vec3(0.75, 0.9, 0.6), vec3(1.05, 1.0, 0.8), clamp(nl * 1.2 - 0.1 + nd * 0.3, 0.0, 1.0));
	meadow *= 0.85 + nf * 0.3;
	// Fields: rotated grid cells with crop rows, tinted field soil texture.
	vec4 field_s = ground(tex_field_albedo, xz);
	vec3 field_n = ground_n(tex_field_normal, xz);
	float ang = 0.35 + floor(nl * 4.0) * 0.4;
	mat2 rot = mat2(vec2(cos(ang), -sin(ang)), vec2(sin(ang), cos(ang)));
	vec2 fp = rot * xz;
	vec2 cell = floor(fp / vec2(150.0, 95.0));
	float crop = hash2(cell);
	vec2 local = fract(fp / vec2(150.0, 95.0));
	float edge = smoothstep(0.0, 0.025, local.x) * smoothstep(1.0, 0.975, local.x) * smoothstep(0.0, 0.04, local.y) * smoothstep(1.0, 0.96, local.y);
	float rows = 0.5 + 0.5 * sin(fp.x * 2.2);
	vec3 field = field_s.rgb;
	if (crop < 0.25) {
		field *= mix(vec3(1.15, 1.0, 0.55), vec3(1.3, 1.1, 0.6), rows * 0.6 + nd * 0.4);   // wheat
	} else if (crop < 0.45) {
		field *= mix(vec3(0.75, 0.6, 0.45), vec3(0.95, 0.75, 0.6), rows);                  // ploughed
	} else if (crop < 0.65) {
		field *= mix(vec3(0.6, 0.9, 0.5), vec3(0.8, 1.05, 0.55), rows);                    // green crop
	} else if (crop < 0.75) {
		field *= mix(vec3(1.0, 0.95, 0.6), vec3(0.9, 1.0, 0.6), rows * 0.5 + nd * 0.5);    // hay meadow
	}
	float field_mask = edge * smoothstep(0.62, 0.8, region.r) * (1.0 - smoothstep(0.12, 0.2, slope)) * smoothstep(0.45, 0.6, nl) * (1.0 - smoothstep(55.0, 70.0, h));
	vec3 vale = mix(meadow, field, field_mask);
	vec3 vale_n = mix(grass_n, field_n, field_mask);

	// ---- Highlands: alpine grass, rock, snow
	vec3 alpine = grass_s.rgb * mix(vec3(0.8, 0.85, 0.9), vec3(1.1, 1.0, 1.3), clamp(nm + nd * 0.3 - 0.2, 0.0, 1.0));
	vec3 rock_grey = rock_s.rgb * mix(vec3(0.85, 0.85, 0.9), vec3(1.1, 1.08, 1.05), nm);
	vec3 hl = mix(alpine, rock_grey, smoothstep(0.22, 0.42, slope + nd * 0.1));
	float snow = smoothstep(snow_line - 25.0, snow_line + 40.0, h + nl * 70.0 + nd * 25.0) * (1.0 - smoothstep(0.22, 0.42, slope + nd * 0.15));
	snow = max(snow, snow_cover * (1.0 - smoothstep(0.35, 0.55, slope)) * smoothstep(80.0, 140.0, h));
	vec4 snow_s = ground(tex_snow_albedo, xz);
	vec3 snow_n = ground_n(tex_snow_normal, xz);
	vec3 snow_col = snow_s.rgb * (0.92 + nf * 0.08);
	hl = mix(hl, snow_col, snow);

	// ---- Mesa: sand flats and banded red rock
	vec3 sand_d = sand_s.rgb * mix(vec3(1.0, 0.78, 0.55), vec3(1.15, 0.9, 0.65), clamp(nm + nd * 0.4 - 0.2, 0.0, 1.0));
	sand_d *= 0.9 + nf * 0.15;
	float strata = 0.5 + 0.5 * sin(h * 1.15 + nd * 3.0 + nl * 6.0);
	vec3 red_rock = rock_s.rgb * mix(vec3(0.9, 0.45, 0.3), vec3(1.2, 0.62, 0.42), strata);
	vec3 mesa = mix(sand_d, sand_s.rgb * vec3(0.62, 0.6, 0.35), smoothstep(0.55, 0.75, nm) * 0.5);
	mesa = mix(mesa, red_rock, smoothstep(0.16, 0.34, slope + nd * 0.08));

	// ---- Coast: beach sand, cliff grass, cliff rock
	vec3 beach = sand_s.rgb * mix(vec3(1.0, 0.96, 0.82), vec3(1.08, 1.04, 0.9), nd);
	vec3 coastal_grass = grass_s.rgb * mix(vec3(0.85, 0.95, 0.85), vec3(1.1, 1.05, 1.2), nm);
	vec3 coast = mix(coastal_grass, beach, 1.0 - smoothstep(2.6, 4.8, h + nd * 1.2));
	coast = mix(coast, rock_s.rgb * vec3(0.95, 0.92, 0.85), smoothstep(0.3, 0.5, slope));
	// Underwater sand
	coast = mix(coast, sand_s.rgb * vec3(0.68, 0.66, 0.55), 1.0 - smoothstep(-0.5, 0.5, h));

	vec4 rw = region / max(region.r + region.g + region.b + region.a, 0.001);
	vec3 col = vale * rw.r + hl * rw.g + mesa * rw.b + coast * rw.a;
	// Blended ground normal in tangent space (region-weighted like the albedo).
	vec3 gn = (vale_n * rw.r + mix(grass_n, rock_n, smoothstep(0.22, 0.42, slope + nd * 0.1)) * rw.g
			+ mix(sand_n, rock_n, smoothstep(0.16, 0.34, slope + nd * 0.08)) * rw.b
			+ mix(grass_n, rock_n, smoothstep(0.3, 0.5, slope)) * rw.a);	// Steep slopes anywhere become rock.
	vec3 any_rock = mix(rock_grey, red_rock, rw.b);
	float steep = smoothstep(0.5, 0.7, slope) * (1.0 - snow);
	col = mix(col, any_rock, steep);
	gn = mix(gn, rock_n, steep);
	// Large-scale colour variation breaks the "same everywhere" feel on far hillsides.
	float macro_var = texture(noise_large, xz * 0.00042).r;
	col *= 0.82 + macro_var * 0.36;
	col = mix(col, col * vec3(0.94, 0.98, 1.06), smoothstep(0.4, 0.75, macro_var) * 0.4);

	// ---- Road verges: worn dirt / gravel within a few metres of the asphalt edge
	vec2 ruv = (xz + vec2(map_half)) / (2.0 * map_half);
	float rd = texture(road_dist_tex, ruv).r * 255.0;
	// Full verge up to the road's skirt end (~2 m from the lane edge), then fading into the ground.
	float verge = 1.0 - smoothstep(1.6, 3.0 + nd * 2.5, rd);
	vec4 dirt_s = ground(tex_dirt_albedo, xz);
	vec3 dirt_n = ground_n(tex_dirt_normal, xz);
	vec4 gravel_s = ground(tex_gravel_albedo, xz);
	vec3 gravel_n = ground_n(tex_gravel_normal, xz);
	// Detail of dirt / gravel, colour pinned to the shared verge soil (road_verge.gdshaderinc) like the road's skirt.
	vec3 verge_col = mix(dirt_s.rgb, gravel_s.rgb, 0.35 + nf * 0.4) * (VERGE_SOIL / VERGE_TEX_MEAN);
	vec3 verge_n = mix(dirt_n, gravel_n, 0.35 + nf * 0.4);
	float verge_k = verge * 0.92 * (1.0 - snow * 0.5);
	col = mix(col, verge_col, verge_k);
	gn = mix(gn, verge_n, verge_k);

	// Roughness from the textures' alpha, adjusted per state.
	float rough = mix(grass_s.a, rock_s.a, steep);
	rough = mix(rough, snow_s.a, snow);
	rough = mix(rough, mix(dirt_s.a, gravel_s.a, 0.35 + nf * 0.4), verge_k);
	rough = mix(rough, 0.55, snow * 0.5);
	// Wetness: darker, glossier (puddles in flat spots).
	float puddle = smoothstep(0.62, 0.75, nd) * (1.0 - smoothstep(0.05, 0.12, slope));
	col *= 1.0 - wetness * 0.28;
	rough = mix(rough, 0.25, wetness * (0.35 + puddle * 0.65));

	vec3 nrm_ts = gn;
	nrm_ts.xy *= nfade;
	NORMAL_MAP = normalize(nrm_ts) * 0.5 + 0.5;
	ALBEDO = col;
	ROUGHNESS = rough;
	SPECULAR = 0.3 + wetness * 0.3;
}
