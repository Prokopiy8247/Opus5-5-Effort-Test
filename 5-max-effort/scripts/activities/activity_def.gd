class_name ActivityDef
extends Resource
## One road activity (data-driven, generated by tools/build_activities.gd into data/activities/).
## Positions are world-space; samples refer to the 2 m road samples in data/world/roads.json.

enum Kind { SPEED_TRAP, SPEED_ZONE, DRIFT_ZONE, DANGER_SIGN, RACE, TIME_TRIAL, COLLECTIBLES }

const KIND_NAMES := ["Speed Trap", "Speed Zone", "Drift Zone", "Danger Sign", "Road Race", "Time Trial", "Festival Boards"]
const DIR := "res://data/activities/"

@export var id: String = ""
@export var kind: Kind = Kind.SPEED_TRAP
@export var display_name: String = ""
@export var region: String = ""
@export var road: int = 0
@export var s0: int = 0                                  ## start sample (trigger / start gate)
@export var s1: int = 0                                  ## end sample (zones), finish sample (races)
@export var dir: int = 1                                 ## travel direction along the road samples
@export var position: Vector3 = Vector3.ZERO             ## trigger / start gate (road centre)
@export var heading: Vector3 = Vector3.FORWARD           ## travel direction at the start
@export var end_position: Vector3 = Vector3.ZERO         ## end gate (zones)
@export var end_heading: Vector3 = Vector3.FORWARD
@export var width: float = 8.0                           ## road width at the start (gate span)
@export var points: PackedVector3Array = PackedVector3Array()   ## race checkpoints (last = finish) / boards
@export var yaws: PackedFloat32Array = PackedFloat32Array()     ## per-point yaw (boards)
@export var targets: PackedFloat32Array = PackedFloat32Array()  ## 1, 2, 3 star thresholds
@export var lower_is_better: bool = false
@export var unit: String = ""
@export var reward: int = 500                            ## credits per new star
@export var length_m: float = 0.0
@export var prop_position: Vector3 = Vector3.ZERO        ## camera / ramp placement
@export var prop_yaw: float = 0.0


func kind_name() -> String:
	return KIND_NAMES[kind]


func stars_for(value: float) -> int:
	var s := 0
	for t in targets:
		if (lower_is_better and value <= t) or (not lower_is_better and value >= t):
			s += 1
	return s


func format_value(value: float, mph: bool = false) -> String:
	match unit:
		"s":
			return format_time(value)
		"km/h":
			return "%d mph" % int(round(value * 0.621371)) if mph else "%d km/h" % int(round(value))
		"boards":
			return "%d" % int(value)
		"m":
			return "%d m" % int(round(value))
		_:
			return "%s pts" % _thousands(int(round(value)))


static func format_time(t: float) -> String:
	if t < 0.0:
		return "--:--.--"
	var m := int(t / 60.0)
	return "%d:%05.2f" % [m, t - m * 60.0]


static func _thousands(v: int) -> String:
	var s := str(absi(v))
	var out := ""
	while s.length() > 3:
		out = "," + s.substr(s.length() - 3) + out
		s = s.substr(0, s.length() - 3)
	return ("-" if v < 0 else "") + s + out


static func load_all() -> Array[ActivityDef]:
	var out: Array[ActivityDef] = []
	if not DirAccess.dir_exists_absolute(DIR):
		return out
	var files := Array(DirAccess.get_files_at(DIR))
	files.sort()
	for f in files:
		var fname := String(f).trim_suffix(".remap")
		if fname.ends_with(".tres"):
			var d := load(DIR + fname) as ActivityDef
			if d != null:
				out.append(d)
	return out


static func world_props(defs: Array[ActivityDef]) -> Array:
	## static props the world builds at load (gates, speed cameras, ramps, signs, festival boards)
	var props: Array = []
	for d in defs:
		match d.kind:
			Kind.SPEED_TRAP:
				props.append({"k": "speed_camera", "p": _arr(d.prop_position), "r": d.prop_yaw})
			Kind.SPEED_ZONE, Kind.DRIFT_ZONE:
				props.append({"k": "checkpoint_gate", "p": _arr(d.position), "r": _yaw(d.heading), "sx": _gate_scale(d.width)})
				props.append({"k": "checkpoint_gate", "p": _arr(d.end_position), "r": _yaw(d.end_heading), "sx": _gate_scale(d.width)})
			Kind.DANGER_SIGN:
				props.append({"k": "ramp_jump", "p": _arr(d.prop_position), "r": d.prop_yaw})
				var side := d.prop_position - d.position
				var sign_p := d.prop_position - d.heading * 16.0 + side.normalized() * 4.5
				props.append({"k": "sign_route", "p": _arr(sign_p), "r": _yaw(-d.heading), "text": "DANGER SIGN"})
			Kind.RACE, Kind.TIME_TRIAL:
				props.append({"k": "checkpoint_gate", "p": _arr(d.position), "r": _yaw(d.heading), "sx": _gate_scale(d.width)})
				if d.kind == Kind.RACE and d.points.size() > 0:
					props.append({"k": "checkpoint_gate", "p": _arr(d.points[d.points.size() - 1]), "r": _yaw(d.end_heading),
						"sx": _gate_scale(d.width)})
			Kind.COLLECTIBLES:
				for i in d.points.size():
					props.append({"k": "smash_board", "p": _arr(d.points[i]), "r": d.yaws[i] if i < d.yaws.size() else 0.0})
	return props


static func exclusions(defs: Array[ActivityDef]) -> Array:
	## areas kept clear of trees: ramp run-up and landing strips, gates
	var ex: Array = []
	for d in defs:
		if d.kind == Kind.DANGER_SIGN:
			for k in range(-2, 10):
				var p := d.prop_position + d.heading * (k * 12.0)
				ex.append([Vector2(p.x, p.z), 14.0])
		elif d.kind != Kind.COLLECTIBLES and d.kind != Kind.SPEED_TRAP:
			ex.append([Vector2(d.position.x, d.position.z), 12.0])
	return ex


static func _gate_scale(w: float) -> float:
	return clampf((w + 5.0) / 13.0, 0.8, 2.2)


static func _yaw(h: Vector3) -> float:
	## yaw that turns local +Z onto h (gates / ramps are modelled facing +Z in Godot space)
	return atan2(h.x, h.z)


static func _arr(p: Vector3) -> Array:
	return [p.x, p.y, p.z]
